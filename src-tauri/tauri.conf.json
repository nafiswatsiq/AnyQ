{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyQ",
  "version": "0.1.0",
  "identifier": "com.nafis.anyq",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "live",
        "title": "AnyQ",
        "width": 180,
        "height": 36,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "settings",
        "title": "AnyQ Settings",
        "url": "settings.html",
        "width": 680,
        "height": 520,
        "visible": false
      },
      {
        "label": "help",
        "title": "AnyQ Help",
        "url": "help.html",
        "width": 620,
        "height": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
